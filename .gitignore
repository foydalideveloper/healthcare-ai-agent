ml/models/
checkpoints/
weights/
.cache/
.huggingface/

# --- Database / runtime state ---
*.db
*.sqlite
*.sqlite3
*.sav
*.log
tmp/
temp/
.tmp/

# --- Third-party datasets (regenerable from upstream; total ~42 GB,
# blocks GitHub push if included). The migration_*.sql / migration_*.json
# files at backend/data/ root ARE source-of-truth and stay tracked. ---
backend/data/aihub/
backend/data/knhanes/
backend/data/training/
# Another aihub Korean food image dataset (16 GB of .jpg + per-image
# CSV/properties metadata). ml/inference/ and ml/training/ are kept.
ml/data/

# --- Pipeline runtime state + transient fixtures ---
# Inbox is a receiving area for in-flight test files (1.8 GB of fixtures).
backend/glasses_watcher/inbox/
backend/glasses_watcher/temp_frames/
backend/glasses_watcher/logs/
backend/glasses_watcher/processed*.json

# --- React Native HealthGlassesApp: re-include scaffolded launcher
# icons + iOS asset-catalog manifests so a fresh clone builds. Scoped
# narrowly to platform resource folders — images in src/, assets/, or
# debug screenshots stay ignored by the parent *.png/*.jpg rules. ---
!frontend/HealthGlassesApp/android/app/src/main/res/**/*.png
!frontend/HealthGlassesApp/android/app/src/main/res/**/*.jpg
!frontend/HealthGlassesApp/ios/**/*.png
!frontend/HealthGlassesApp/ios/**/*.jpg
!frontend/HealthGlassesApp/ios/**/Contents.json

# --- Dashboard icons (re-include the icons/ folder so a fresh clone
# renders them without a separate file transfer). ---
!frontend/hrt-dashboard/public/icons/**

# --- Suspicious top-level junk (shell-redirect safety net) ---
/=*
